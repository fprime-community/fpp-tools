class NodeVisitor:
    r"""
    Base class for read-only AST traversals.
    
    Subclass it and override `visit_<TypeName>` for the node types you care
    about, where `<TypeName>` is the node's class name (the same string as
    `type(node).__name__`), e.g. `visit_DefComponent`. Traversal is depth-first,
    pre-order, in source order.
    
    ```python
    class Components(fpp_python.NodeVisitor):
        def __init__(self):
            self.names = []
    
        def visit_DefComponent(self, node):
            self.names.append(node.name)
            super().visit_DefComponent(node)   # keep descending
    
    v = Components()
    for root in model.ast():
        v.visit(root)
    ```
    
    * Recursion is **deep by default**. Call `super().visit_<TypeName>(node)` to
      descend from an override; omit it to prune that subtree.
    * Override `generic_visit` to hook *every* node — trace it, or return without
      calling `super().generic_visit(node)` to make the whole pass shallow.
    * A node type with no `visit_<TypeName>` override falls through to
      `generic_visit`.
    * To stop early, raise an exception — return values are not inspected.
    """
    def visit_Connection(self, node: AstNode) -> typing.Any: ...
    def visit_DefAbsType(self, node: DefAbsType) -> typing.Any: ...
    def visit_DefAction(self, node: DefAction) -> typing.Any: ...
    def visit_DefAliasType(self, node: DefAliasType) -> typing.Any: ...
    def visit_DefArray(self, node: DefArray) -> typing.Any: ...
    def visit_DefChoice(self, node: DefChoice) -> typing.Any: ...
    def visit_DefComponent(self, node: DefComponent) -> typing.Any: ...
    def visit_DefComponentInstance(self, node: DefComponentInstance) -> typing.Any: ...
    def visit_DefConstant(self, node: DefConstant) -> typing.Any: ...
    def visit_DefEnum(self, node: DefEnum) -> typing.Any: ...
    def visit_DefEnumConstant(self, node: DefEnumConstant) -> typing.Any: ...
    def visit_DefGuard(self, node: DefGuard) -> typing.Any: ...
    def visit_DefInterface(self, node: DefInterface) -> typing.Any: ...
    def visit_DefModule(self, node: DefModule) -> typing.Any: ...
    def visit_DefPort(self, node: DefPort) -> typing.Any: ...
    def visit_DefSignal(self, node: DefSignal) -> typing.Any: ...
    def visit_DefState(self, node: DefState) -> typing.Any: ...
    def visit_DefStateMachine(self, node: DefStateMachine) -> typing.Any: ...
    def visit_DefStruct(self, node: DefStruct) -> typing.Any: ...
    def visit_DefSystem(self, node: DefSystem) -> typing.Any: ...
    def visit_DefTopology(self, node: DefTopology) -> typing.Any: ...
    def visit_DoExpr(self, node: DoExpr) -> typing.Any: ...
    def visit_EventThrottle(self, node: EventThrottle) -> typing.Any: ...
    def visit_Expr(self, node: Expr) -> typing.Any: ...
    def visit_FormalParam(self, node: FormalParam) -> typing.Any: ...
    def visit_Ident(self, node: Ident) -> typing.Any: ...
    def visit_LitString(self, node: LitString) -> typing.Any: ...
    def visit_PortInstanceIdentifier(self, node: AstNode) -> typing.Any: ...
    def visit_Qualified(self, node: Qualified) -> typing.Any: ...
    def visit_SpecCommand(self, node: SpecCommand) -> typing.Any: ...
    def visit_SpecContainer(self, node: SpecContainer) -> typing.Any: ...
    def visit_SpecDirectConnectionGraph(self, node: SpecDirectConnectionGraph) -> typing.Any: ...
    def visit_SpecEvent(self, node: SpecEvent) -> typing.Any: ...
