 Generated by Cargo
# will have a `.gitignore` file at the root of the package.
# This file is for the project root and for packages in a workspace.
# See cargo's documentation for more information.

# Standard build output
**/target/

# Dependency manifests
# This is usually only committed in binary projects, not libraries.
# If you are building a library, you might want to uncomment this.
# Cargo.lock

# OS-specific files
.DS_Store
Thumbs.db

# IDE-specific files
.idea/
*.swp
*.swo

# Temporary files
*.log
*.bak
*.tmp

# Python build/test artifacts (the fpp_python wheel + its test suite)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
build/
dist/
*.egg-info/
# Built extension modules (the wheel ships these; never commit them). The
# checked-in `fpp_python/fpp_python.pyi` type stub is NOT matched by this.
*.so
*.pyd
venv/

# Ignore any AI files
CLAUDE.md

# Ignore any workspace working docs
notes/
